# Atlas: Database → Connect → Drivers. Use the mongodb+srv string.
# URL-encode special characters in the password. Network Access must allow this computer.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/school-transport?retryWrites=true&w=majority
MONGODB_DB=school-transport
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CRON_SECRET=replace-with-a-cron-secret
SEED_PASSWORD=ChangeMe123!
APP_URL=http://localhost:3000

# Optional. Live GPS and push stay disabled until both values are set.
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
